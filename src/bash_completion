#!/bin/bash

start="# Start autogenerated PTOF completion"
end="# End autogenerated PTOF completion"
full_cleanup=false

ptof_bash_completion_clean () {
    sed -i "/$start/,/$end/d" ~/.bash_completion
    # This seems overkill, but complete -r with specific arguments misses
    # possible previously auto-generated minimal completion for the command
    # from multiple paths, so we fully reset completion
    complete -r
    source /etc/bash_completion
    $full_cleanup && unset -f ptof_bash_completion_clean
    full_cleanup=true
}

ptof_bash_completion_clean

dir_script=`realpath "$BASH_SOURCE" | xargs dirname`

cat >> ~/.bash_completion <<'EOF'
# Start autogenerated PTOF completion

_ptof_make() {
    local dir="$dir_script"
    local script=ptof_make
    local cmd_name=`realpath "$1"`
    if [[ "$cmd_name" == "$dir/$script" ]] ; then
        case $COMP_CWORD in
            1)
                local word="${COMP_WORDS[1]}"
                local execs="ParticleTrackingOF \
ParticleTrackingOF_TwoPhaseNonStationary"
                COMPREPLY=( $(compgen -W "$execs" -- $word) ) ;;
            2)
                local word="${COMP_WORDS[2]}"
                local models=`cat "$dir/models" | xargs -rd'\n'`
                COMPREPLY=( $(compgen -W "$models" -- $word) ) ;;
            3)
                local word="${COMP_WORDS[3]}"
                local par="serial parallel"
                COMPREPLY=( $(compgen -W "$par" -- $word) ) ;;
            4)
                local word="${COMP_WORDS[4]}"
                local build="debug release"
                COMPREPLY=( $(compgen -W "$build" -- $word) ) ;;
        esac
    fi
} &&
    complete -F _ptof_make ptof_make

_ptof_make_all() {
    local dir="$dir_script"
    local script=ptof_make_all
    local cmd_name=`realpath "$1"`
    if [[ "$cmd_name" == "$dir/$script" ]] ; then
        case $COMP_CWORD in
            1)
                local word="${COMP_WORDS[1]}"
                local execs="ParticleTrackingOF \
ParticleTrackingOF_TwoPhaseNonStationary"
                COMPREPLY=( $(compgen -W "$execs" -- $word) ) ;;
            2)
                local word="${COMP_WORDS[3]}"
                local par="serial parallel"
                COMPREPLY=( $(compgen -W "$par" -- $word) ) ;;
            3)
                local word="${COMP_WORDS[4]}"
                local build="debug release"
                COMPREPLY=( $(compgen -W "$build" -- $word) ) ;;
        esac
    fi
} &&
    complete -F _ptof_make_all ptof_make_all

_ptof_set_model() {
    local dir="$dir_script"
    local script=ptof_set_model
    local cmd_name=`realpath "$1"`
    if [[ "$cmd_name" == "$dir/$script" ]] ; then
        case $COMP_CWORD in
            1)
                local word="${COMP_WORDS[1]}"
                local execs="ParticleTrackingOF \
ParticleTrackingOF_TwoPhaseNonStationary"
                COMPREPLY=( $(compgen -W "$execs" -- $word) ) ;;
            2)
                local word="${COMP_WORDS[2]}"
                local models=`cat "$dir/models" | xargs -rd'\n'`
                COMPREPLY=( $(compgen -W "$models" -- $word) ) ;;
            3)
                local word="${COMP_WORDS[3]}"
                local par="serial parallel"
                COMPREPLY=( $(compgen -W "$par" -- $word) ) ;;
        esac
    fi
} &&
    complete -F _ptof_set_model ptof_set_model

# End autogenerated PTOF completion
EOF

sed -i "/$start/,/$end/{s,\$dir_script,${dir_script},g}" ~/.bash_completion

source ~/.bash_completion
